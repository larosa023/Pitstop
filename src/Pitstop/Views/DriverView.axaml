<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pitstop.ViewModels"
             x:Class="Pitstop.Views.DriverView"
             x:DataType="vm:DriverViewModel">

  <ScrollViewer>
    <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left">
      <StackPanel Classes="pageheader" Margin="0,0,0,12">
        <TextBlock Classes="h1" Text="Driver" />
        <TextBlock Classes="subtitle" Text="Your graphics card, the driver it's running, and the newest ones from NVIDIA." />
      </StackPanel>

      <!-- Install progress -->
      <Border Classes="card" IsVisible="{Binding ShowProgress}" Margin="0,0,0,8">
        <StackPanel Spacing="14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Classes="ghost" Content="Cancel" IsVisible="{Binding CanCancel}" Command="{Binding CancelCommand}" />
              <Button Classes="accent" Content="Restart Windows" IsVisible="{Binding RestartNeeded}" Command="{Binding RestartWindowsCommand}" />
              <Button Classes="ghost" Content="Close" IsVisible="{Binding HasResult}" Command="{Binding DismissCommand}" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Classes="h2" Text="{Binding ProgressTitle}" />
              <TextBlock Classes="label" Text="{Binding ElapsedText}" IsVisible="{Binding IsInstalling}" />
            </StackPanel>
          </DockPanel>

          <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StepViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,22,6">
                  <Ellipse Classes="step" Classes.active="{Binding IsActive}" Classes.done="{Binding IsDone}" Classes.failed="{Binding IsFailed}" />
                  <TextBlock Classes="steplabel" Classes.active="{Binding IsActive}" Classes.done="{Binding IsDone}" Text="{Binding Label}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Spacing="8" IsVisible="{Binding IsInstalling}">
            <TextBlock Text="{Binding ProgressMessage}" TextWrapping="Wrap" FontSize="14" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIndeterminate}" />
            <TextBlock Classes="label" Text="{Binding ProgressDetail}" />
          </StackPanel>

          <Border Classes="banner good" IsVisible="{Binding ResultOk}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="icon good" Text="&#xE73E;" />
              <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Classes="banner bad" IsVisible="{Binding ResultFailed}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="icon bad" Text="&#xE783;" VerticalAlignment="Top" Margin="0,2,0,0" />
              <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontWeight="SemiBold" MaxWidth="700" />
            </StackPanel>
          </Border>
          <TextBlock Classes="label" Text="{Binding WarningsText}" TextWrapping="Wrap" IsVisible="{Binding HasWarnings}" />
        </StackPanel>
      </Border>

      <!-- Graphics card -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
            <TextBlock Classes="icon accent" FontSize="24" HorizontalAlignment="Center" Text="&#xE950;" />
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0" Spacing="3">
            <TextBlock Classes="h2" FontSize="17" Text="{Binding GpuName}" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="{Binding GpuDetail}" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" IsVisible="{Binding HasGpu}">
              <StackPanel Spacing="1">
                <TextBlock Classes="eyebrow" Text="INSTALLED DRIVER" />
                <TextBlock Classes="big" Text="{Binding InstalledVersion}" />
                <TextBlock Classes="label" Text="{Binding InstalledDetail}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="2" Classes="pill" VerticalAlignment="Top" IsVisible="{Binding HasStatus}"
                  Classes.good="{Binding StatusGood}" Classes.accent="{Binding StatusAccent}" Classes.warn="{Binding StatusWarn}">
            <TextBlock Text="{Binding StatusText}" />
          </Border>
        </Grid>
      </Border>

      <!-- Latest drivers -->
      <DockPanel Margin="4,16,4,0" IsVisible="{Binding HasGpu}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="faint" VerticalAlignment="Center" Text="{Binding CheckedText}" />
          <Button Classes="ghost" Padding="8,3" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsChecking}" ToolTip.Tip="Check NVIDIA for new drivers (F5)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" FontSize="12" Text="&#xE72C;" />
              <TextBlock Text="Check now" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Classes="eyebrow" Text="LATEST FROM NVIDIA" VerticalAlignment="Bottom" />
      </DockPanel>
      <Border Classes="banner warn" IsVisible="{Binding HasCatalogError}">
        <TextBlock Text="{Binding CatalogError}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="card" Padding="20,2" IsVisible="{Binding HasGpu}">
        <StackPanel>
          <ContentControl Content="{Binding GameReady}" />
          <ContentControl Content="{Binding Studio}" />
        </StackPanel>
      </Border>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChecking}" Margin="2,0" MinHeight="3" />

      <!-- Options -->
      <TextBlock Classes="eyebrow" Text="INSTALL OPTIONS" Margin="4,16,4,0" IsVisible="{Binding HasGpu}" />
      <Border Classes="card" Padding="20,2" IsVisible="{Binding HasGpu}" IsEnabled="{Binding !IsInstalling}">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <CheckBox Content="PhysX" IsChecked="{Binding PhysX}" Margin="0,0,16,0"
                          ToolTip.Tip="Physics for a few older games (Borderlands 2, Mirror's Edge, Batman: Arkham)." />
                <CheckBox Content="HD Audio" IsChecked="{Binding HdAudio}" Margin="0,0,16,0"
                          ToolTip.Tip="Sound over HDMI/DisplayPort, to a TV or monitor speakers." />
                <CheckBox Content="USB-C" IsChecked="{Binding UsbC}"
                          ToolTip.Tip="Only for cards with a USB-C (VirtualLink) port." />
              </WrapPanel>
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="What to install" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap"
                           Text="The display driver always. No NVIDIA App, no GeForce Experience, no telemetry." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" OnContent="" OffContent="" IsChecked="{Binding Clean}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Perform a clean install" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Resets every NVIDIA setting and game profile to default. Good for fixing odd problems." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" OnContent="" OffContent="" IsChecked="{Binding RestorePoint}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Create a restore point first" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="A Windows restore point before every install, so you can always undo it." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" OnContent="" OffContent="" IsChecked="{Binding DisableTelemetry}" />
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Turn off NVIDIA telemetry tasks" FontWeight="SemiBold" />
                <TextBlock Classes="label" TextWrapping="Wrap" Text="Disables any NVIDIA data-collection and update-check tasks the driver leaves behind." />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
      <TextBlock Classes="faint" Margin="4,4,4,0" TextWrapping="Wrap" IsVisible="{Binding HasGpu}"
                 Text="Installing asks for admin rights once. Downloads come only from NVIDIA's servers and are checked against NVIDIA's digital signature." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
