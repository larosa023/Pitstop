<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pitstop.ViewModels"
             x:Class="Pitstop.Views.DriverRowView"
             x:DataType="vm:DriverRowViewModel">
  <Border Classes="row">
    <Grid ColumnDefinitions="150,*,Auto">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding BranchText}" FontWeight="SemiBold" />
        <TextBlock Classes="faint" Text="{Binding BranchHelp}" TextWrapping="Wrap" FontSize="11" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="2" Margin="16,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding VersionText}" FontSize="20" FontWeight="SemiBold" />
          <Border Classes="pill good" IsVisible="{Binding IsInstalled}">
            <TextBlock Text="Installed" />
          </Border>
          <Border Classes="pill accent" IsVisible="{Binding IsNewer}">
            <TextBlock Text="New" />
          </Border>
          <Border Classes="pill" IsVisible="{Binding IsSaved}" ToolTip.Tip="Already downloaded: installs without downloading again.">
            <TextBlock Text="Saved" Foreground="{DynamicResource TextMuted}" />
          </Border>
        </StackPanel>
        <TextBlock Classes="label" Text="{Binding DetailText}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="ghost" Content="Release notes" IsVisible="{Binding HasNotes}" Command="{Binding NotesCommand}" />
        <Button Classes="accent" Content="{Binding InstallText}" IsVisible="{Binding IsNewer}" Command="{Binding InstallCommand}"
                IsEnabled="{Binding CanInstall}" />
        <Button Classes="subtle" Content="{Binding InstallText}" IsVisible="{Binding !IsNewer}" Command="{Binding InstallCommand}"
                IsEnabled="{Binding CanInstall}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
